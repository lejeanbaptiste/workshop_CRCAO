


# Remplacez ce motif par votre propre regex.
find = r"YOUR REGEX HERE"
replace = r"YOUR REGEX HERE"

# Importez les bibliothèques nécessaires.
import os
import re
import glob
from pathlib import Path
from tqdm import tqdm
from bs4 import BeautifulSoup

data_candidates = [
    Path("data/taiping-yulan-raw"),
    Path("../data/taiping-yulan-raw"),
    Path("../../data/taiping-yulan-raw"),
    Path("../../../data/taiping-yulan-raw"),
    Path("../../../../data/taiping-yulan-raw"),
]
input_path = next((candidate for candidate in data_candidates if candidate.exists()), None)
if input_path is None:
    raise FileNotFoundError(f"Raw corpus not found; checked: {data_candidates}")
input_dir = str(input_path)
print(f"Input corpus: {input_path.resolve()}")
print(f"Input files: {len(glob.glob(f'{input_dir}/*.xml'))}")
output_dir = "outputs/chapter-05/titles-demo"
os.makedirs(output_dir, exist_ok=True)

print('Finding and replacing...')

# Parcourez tous les fichiers XML.
for input_path in tqdm(sorted(glob.glob(f"{input_dir}/*.xml"))):
    # Ouvrez le fichier XML.
    with open(input_path, "r", encoding="utf-8") as f:
        xml = f.read()

    # Cherchez et remplacez.
    new_xml = re.sub(find, replace, xml)

    # BeautifulSoup reparcourt le XML pour vérifier que le résultat reste lisible.
    soup = BeautifulSoup(new_xml, "xml")

    # Enregistrez le fichier modifié.
    output_path = os.path.join(output_dir, os.path.basename(input_path))
    with open(output_path, "w", encoding="utf-8") as f:
        f.write(str(soup))

print("DONE")





title_count = 0

# Parcourez tous les fichiers XML.
for path in sorted(glob.glob("outputs/chapter-05/titles-demo/*.xml")):
    # Ouvrez le fichier XML.
    with open(path, "r", encoding="utf-8") as f:
        soup = BeautifulSoup(f.read(), "xml")

    # Comptez les titres.
    local_count = len(soup.find_all("title"))

    # Ajoutez le nombre de titres trouvés dans le fichier courant au total.
    title_count += local_count

print(f"Found {title_count} titles")



